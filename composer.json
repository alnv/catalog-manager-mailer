{
  "name": "alnv/catalog-manager-mailer",
  "description": "Extension for Catalog Manager.",
  "keywords": [ "contao", "catalog", "manager", "notification", "newsletter", "email" ],
  "type": "contao-module",
  "homepage": "https://catalog-manager.alexandernaumov.de",
  "license": "proprietary",
  "authors": [
    {
      "name": "Alexander Naumov",
      "homepage": "https://www.alexandernaumov.de",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "mail@alexandernaumov.de",
    "issues": "https://github.com/alnv/catalog-manager-mailer/issues",
    "wiki": "https://catalog-manager.alexandernaumov.de/dokumentation.html"
  },
  "require": {
    "php":">=8.0",
    "contao/core-bundle": "~5.3",
    "alnv/catalog-manager": "^2.0",
    "terminal42/notification_center":"~2.0"
  },
  "autoload": {
    "psr-4": {
      "Alnv\\CatalogManagerMailerBundle\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist"
  },
  "extra": {
    "contao": {
      "sources": {
        "": "system/modules/catalog-manager-mailer-bundle"
      }
    },
    "contao-manager-plugin": "Alnv\\CatalogManagerMailerBundle\\ContaoManager\\Plugin"
  }
}